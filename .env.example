# ==============================================================================
# Course Enrolment Advisor - Environment Configuration
# ==============================================================================

# 1. PostgreSQL (System of Record for Business Entities + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=advisor_db
POSTGRES_USER=advisor_user
POSTGRES_PASSWORD=advisor_password
POSTGRES_SSLMODE=disable

# 2. MongoDB (System of Record for Flexible Course Documents)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=advisor_catalog
MONGO_USER=advisor_admin
MONGO_PASSWORD=advisor_secret
MONGO_AUTH_SOURCE=admin

# 3. Redis (Derived Student Session Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL_SECONDS=1800

# 4. Neo4j (Derived Graph for Prerequisites & Completed Courses)
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=advisor_neo4j_password

# 5. Qdrant (Derived Dedicated Vector Search Engine)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=course_embeddings

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DISTANCE=Cosine
